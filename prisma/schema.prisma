generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  TECHNICIAN
  RESELLER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RouterProtocol {
  API
  API_SSL
  REST
}

enum RouterStatus {
  ONLINE
  OFFLINE
  WARNING
}

enum HealthState {
  HEALTHY
  WARNING
  CRITICAL
  OFFLINE
}

enum NotificationType {
  ROUTER_OFFLINE
  ROUTER_ONLINE
  PAYMENT_SUCCESSFUL
  PACKAGE_EXPIRING
  VOUCHER_CREATED
  PROVISIONING_FAILED
  SYSTEM_ERROR
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum AuditAction {
  LOGIN
  LOGOUT
  ROUTER_ADDED
  ROUTER_DELETED
  USER_CREATED
  USER_DISABLED
  USER_DELETED
  VOUCHER_GENERATED
  PAYMENT_MODIFIED
  PACKAGE_MODIFIED
  CONFIGURATION_CHANGED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  username     String       @unique
  passwordHash String
  role         RoleName
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  audits       AuditLog[]
  customers    Customer[]

  @@index([email])
  @@index([username])
  @@index([role])
}

model Customer {
  id            String        @id @default(cuid())
  userId        String?
  fullName      String
  phone         String?
  email         String        @unique
  username      String        @unique
  locationId    String?
  status        UserStatus    @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User?         @relation(fields: [userId], references: [id])
  location      Location?     @relation(fields: [locationId], references: [id])
  hotspotUsers  HotspotUser[]
  payments      Payment[]
  vouchers      Voucher[]
  sessions      HotspotSession[]

  @@index([locationId])
  @@index([status])
}

model Router {
  id                  String           @id @default(cuid())
  name                String
  locationId          String?
  ipAddress           String
  protocol            RouterProtocol
  port                Int
  username            String
  password            String
  useSsl              Boolean          @default(false)
  description         String?
  status              RouterStatus     @default(OFFLINE)
  healthState         HealthState      @default(OFFLINE)
  identity            String?
  board               String?
  architecture        String?
  routerOsVersion     String?
  cpuUsage            Float?
  memoryUsage         Float?
  uptime              String?
  publicIp            String?
  lastSeen            DateTime?
  isDemo              Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  location            Location?        @relation(fields: [locationId], references: [id])
  interfaces          RouterInterface[]
  routerMetrics       RouterMetric[]
  hotspotUsers        HotspotUser[]
  sessions            HotspotSession[]
  interfacesRecorded  RouterInterface[] @relation("RouterLiveInterfaces")
  audits              AuditLog[]

  @@index([locationId])
  @@index([status])
  @@index([lastSeen])
}

model Location {
  id              String     @id @default(cuid())
  name            String
  address         String?
  description     String?
  latitude        Float?
  longitude       Float?
  status          String     @default("ACTIVE")
  contact         String?
  openingHours    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  routers         Router[]
  customers       Customer[]
  hotspotUsers    HotspotUser[]
  vouchers        Voucher[]
  packages        Package[]
  sessions       HotspotSession[]

  @@index([status])
}

model HotspotUser {
  id            String          @id @default(cuid())
  username      String
  password      String
  customerId    String?
  routerId      String
  locationId    String?
  profileId     String?
  packageId     String?
  status        String          @default("ACTIVE")
  dataUsed      BigInt          @default(0)
  timeUsed      Int             @default(0)
  expiresAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  customer      Customer?       @relation(fields: [customerId], references: [id])
  router        Router          @relation(fields: [routerId], references: [id])
  location      Location?       @relation(fields: [locationId], references: [id])
  profile       HotspotProfile? @relation(fields: [profileId], references: [id])
  package       Package?        @relation(fields: [packageId], references: [id])
  sessions      HotspotSession[]

  @@index([routerId])
  @@index([locationId])
  @@index([customerId])
  @@index([username])
  @@index([status])
}

model HotspotSession {
  id            String       @id @default(cuid())
  username      String
  ipAddress     String?
  macAddress    String?
  routerId      String
  locationId    String?
  customerId    String?
  userId        String?
  uptime        Int?
  download      BigInt?
  upload        BigInt?
  totalBytes    BigInt?
  loginTime     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  router        Router       @relation(fields: [routerId], references: [id])
  location      Location?    @relation(fields: [locationId], references: [id])
  customer      Customer?    @relation(fields: [customerId], references: [id])
  hotspotUser   HotspotUser? @relation(fields: [userId], references: [id])

  @@index([routerId])
  @@index([locationId])
  @@index([customerId])
  @@index([username])
  @@index([createdAt])
}

model HotspotProfile {
  id              String        @id @default(cuid())
  name            String
  downloadSpeed   String?
  uploadSpeed     String?
  sharedUsers     Int?
  rateLimit       String?
  sessionTimeout  String?
  mikrotikId      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  hotspotUsers    HotspotUser[]

  @@index([name])
}

model Package {
  id              String        @id @default(cuid())
  name            String
  description     String?
  price           Float
  currency        String        @default("USD")
  duration        Int?
  dataLimit       BigInt?
  downloadSpeed   String?
  uploadSpeed     String?
  routerId        String?
  locationId      String?
  profileId       String?
  status          String        @default("ACTIVE")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  location        Location?     @relation(fields: [locationId], references: [id])
  hotspotUsers    HotspotUser[]
  vouchers        Voucher[]

  @@index([locationId])
  @@index([status])
}

model Voucher {
  id          String      @id @default(cuid())
  voucherCode String      @unique
  username    String
  password    String
  packageId   String
  locationId  String?
  customerId  String?
  price       Float
  status      String      @default("UNUSED")
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  package     Package     @relation(fields: [packageId], references: [id])
  location    Location?   @relation(fields: [locationId], references: [id])
  customer    Customer?   @relation(fields: [customerId], references: [id])

  @@index([voucherCode])
  @@index([locationId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  customerId    String
  packageId     String?
  amount        Float
  currency      String        @default("USD")
  provider      String        @default("CASH")
  status        PaymentStatus @default(PENDING)
  reference     String?
  transactionId String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer      @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([transactionId])
  @@index([createdAt])
}

model RouterMetric {
  id         String    @id @default(cuid())
  routerId   String
  cpuUsage   Float?
  memoryUsed Float?
  uptime     String?
  createdAt  DateTime  @default(now())
  router     Router    @relation(fields: [routerId], references: [id])

  @@index([routerId])
  @@index([createdAt])
}

model RouterInterface {
  id            String   @id @default(cuid())
  routerId      String
  name          String
  type          String?
  mtu           Int?
  macAddress    String?
  bytesIn       BigInt?
  bytesOut      BigInt?
  status        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  router        Router   @relation(fields: [routerId], references: [id])
  routerLive    Router?  @relation("RouterLiveInterfaces", fields: [routerId], references: [id])

  @@index([routerId])
  @@index([name])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  action     AuditAction
  details    String?
  routerId   String?
  username   String?
  timestamp  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id])
  router     Router?     @relation(fields: [routerId], references: [id])

  @@index([userId])
  @@index([routerId])
  @@index([timestamp])
}

model Notification {
  id          String            @id @default(cuid())
  type        NotificationType
  title       String
  message     String
  channel     String            @default("in-app")
  isRead      Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

model SupportTicket {
  id          String   @id @default(cuid())
  title       String
  message     String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model Reseller {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Job {
  id          String   @id @default(cuid())
  type        String
  payload     Json
  status      String   @default("PENDING")
  attempts     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model SystemSetting {
  id         String   @id @default(cuid())
  key        String   @unique
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([key])
}
