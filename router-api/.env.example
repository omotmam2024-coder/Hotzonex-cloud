# Supabase → Project Settings → API (the service_role key — keep it on the VPS only)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 32 random bytes, base64. Generate with: npm run genkey
# Back it up offline: without it, stored router passwords cannot be decrypted.
ROUTER_SECRET_KEY=

# The web app's address(es), comma-separated, for CORS
ALLOWED_ORIGINS=https://hotzonex-cloud.vercel.app,http://localhost:5173

# Caddy proxies HTTPS to this
HOST=127.0.0.1
PORT=8787

# How often every router is synced (ms)
SYNC_INTERVAL_MS=60000
