# Used by `pnpm db:migrate` and `pnpm db:seed`. Copy to supabase/.env (git-ignored).
# Values for the local stack are printed by `pnpm db:migrate` / `supabase status`.

# Supabase API URL and SERVICE ROLE key (server-side only; never put this key in apps/web).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection. Local default shown; for a hosted project use the
# connection string from Project Settings → Database. When this points at a
# non-local host, `pnpm db:migrate` pushes migrations there instead of starting Docker.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Password for the seeded SUPER_ADMIN admin@hotzonex.com. Required, no default.
# At least 10 characters with a letter and a digit.
SEED_ADMIN_PASSWORD=
