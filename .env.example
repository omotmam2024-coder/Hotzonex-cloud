# Web app (Vercel → Project → Settings → Environment Variables)
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# HTTPS address of the router API on your VPS (Caddy in front of it)
VITE_ROUTER_API_URL=https://api.example.com
# Used to pre-fill the router onboarding script on the Routers page
# VPS public IP, and the output of `sudo wg show wg0 public-key` on the VPS
VITE_VPS_ENDPOINT=203.0.113.10
VITE_VPS_WG_PUBLIC_KEY=PASTE_VPS_WG_PUBLIC_KEY
