# Hotzonex Cloud web app. Copy to apps/web/.env.local (git-ignored).
# On Vercel: Project → Settings → Environment Variables.
# Only public values belong here. The service-role key must NEVER be set for the web app.

# Supabase API URL. Local stack: http://127.0.0.1:54321
VITE_SUPABASE_URL=
# Supabase anon (public) key. Safe in the browser: Row Level Security enforces access.
VITE_SUPABASE_ANON_KEY=
