# Hotzonex Cloud connector. Copy to apps/connector/.env (git-ignored) or, on the
# VPS, to /etc/hotzonex/connector.env (mode 0600, owned by the service user).
# This process holds the ONLY copies of the service-role key and the encryption key.

# --- Data plane ---------------------------------------------------------------
# Supabase API URL. Local stack: http://127.0.0.1:54321
SUPABASE_URL=
# Service-role key (Supabase → Project Settings → API). Server-side only.
# It must never appear anywhere under apps/web.
SUPABASE_SERVICE_ROLE_KEY=

# --- Router credential encryption ---------------------------------------------
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Losing this key means re-entering every router's credentials. Back it up offline.
ENCRYPTION_KEY=
# Integer; bump when rotating (see docs/RUNBOOK.md → Rotating the encryption key).
ENCRYPTION_KEY_VERSION=1
# Optional, only during rotation: previous keys, "1:<base64>,2:<base64>".
ENCRYPTION_KEYS_RETIRED=

# --- MikroTik -----------------------------------------------------------------
# mock = simulated routers and WireGuard (development). api|rest = real routers;
# each router's own protocol (API / API-SSL / REST) is used.
MIKROTIK_PROVIDER=mock

# --- Scheduling (conservative defaults for metered links) ----------------------
# Default health-poll interval; tenants can override in Settings. 60–3600.
HEALTH_POLL_INTERVAL_SECONDS=300
# How often the connector looks for queued jobs. 2–300.
JOB_POLL_INTERVAL_SECONDS=10
# Jobs run in parallel (across different routers; one session per router).
JOB_CONCURRENCY=4

# --- WireGuard (required when MIKROTIK_PROVIDER is api or rest) -----------------
# VPS interface that routers dial into; its address must be 10.77.0.1/16.
WG_INTERFACE=wg0
# Public key of that interface: wg show wg0 public-key
WG_SERVER_PUBLIC_KEY=
# Public host:port routers dial, e.g. wg.hotzonex.com:51820
WG_ENDPOINT=

# --- Service ------------------------------------------------------------------
# Stable name for this instance (defaults to the hostname).
CONNECTOR_ID=
# GET /healthz is the only inbound endpoint.
HEALTHZ_HOST=0.0.0.0
HEALTHZ_PORT=8080
LOG_LEVEL=info
# Development only: where `pnpm mock:router` stores simulated router conditions.
MOCK_STATE_FILE=.mock-state.json
