{
  "name": "hotzonex-cloud",
  "private": true,
  "description": "Hotzonex Cloud — MikroTik Hotspot Management & WiFi Platform",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @hotzonex/web --filter @hotzonex/connector dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @hotzonex/web test:e2e",
    "test:live": "pnpm --filter @hotzonex/mikrotik test:live",
    "db:migrate": "pnpm --filter @hotzonex/db migrate",
    "db:seed": "pnpm --filter @hotzonex/db seed",
    "db:types": "pnpm --filter @hotzonex/db types",
    "db:types:offline": "pnpm --filter @hotzonex/db types:offline"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
